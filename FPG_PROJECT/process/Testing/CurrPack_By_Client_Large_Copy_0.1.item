  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="360" posY="280">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_3" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJavaRow" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.101 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Custom_Code" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="false" show="false"/>
    <elementParameter field="CHECK" name="SUBTREE_START" value="false" show="false"/>
    <elementParameter field="CHECK" name="END_OF_FLOW" value="false" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tJavaRow" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Program Files (x86)\Talend-Studio\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//-------------------------------------------------------------------------------------&#xD;&#xA;//Package_Status_DateTime and ImportDT arrive as raw epoch-seconds strings with a&#xD;&#xA;//fractional (microsecond) component, e.g. &quot;1788341619.621196&quot; — Talend's built-in&#xD;&#xA;//Date parser can't handle the decimal, so both are typed String on input and&#xD;&#xA;//parsed manually here.&#xD;&#xA;//-------------------------------------------------------------------------------------&#xD;&#xA;&#xD;&#xA;try {&#xD;&#xA; // --- Parse Package_Status_DateTime ---&#xD;&#xA; double statusEpochSeconds = Double.parseDouble(row3.Package_Status_DateTime);&#xD;&#xA; long statusEpochMillis = (long) (statusEpochSeconds * 1000);&#xD;&#xA; java.util.Date packageStatusDateTime = new java.util.Date(statusEpochMillis);&#xD;&#xA;&#xD;&#xA; // --- Apply gmtOffset shift (hours -> millis) ---&#xD;&#xA; double gmtOffsetHours = (row3.gmtOffset != null) ? row3.gmtOffset : 0.0;&#xD;&#xA; long shiftedMillis = statusEpochMillis + (long) (gmtOffsetHours * 3600 * 1000);&#xD;&#xA;&#xD;&#xA; // --- Parse ImportDT (same epoch-with-fraction format) ---&#xD;&#xA; java.util.Date importDT = null;&#xD;&#xA; if (row3.ImportDT != null &amp;&amp; !row3.ImportDT.isEmpty()) {&#xD;&#xA;     double importEpochSeconds = Double.parseDouble(row3.ImportDT);&#xD;&#xA;     importDT = new java.util.Date((long) (importEpochSeconds * 1000));&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; // --- Pass-through columns ---&#xD;&#xA; output_row.ClientID = row3.ClientID;&#xD;&#xA; output_row.TrackingNumber = row3.TrackingNumber;&#xD;&#xA; output_row.PackageId = row3.PackageId;&#xD;&#xA; output_row.gmtOffset = row3.gmtOffset;&#xD;&#xA; output_row.Package_Status_DateTime = packageStatusDateTime;&#xD;&#xA; output_row.CurrentStatusShortDesc = row3.CurrentStatusShortDesc;&#xD;&#xA; output_row.CurrentStatus = row3.CurrentStatus;&#xD;&#xA; output_row.CurrentStatusDescription = row3.CurrentStatusDescription;&#xD;&#xA; output_row.LatestActivityCode = row3.LatestActivityCode;&#xD;&#xA; output_row.LatestActivityCity = row3.LatestActivityCity; // renamed, matches Qlik's &quot;as LatestActivityLocation&quot;&#xD;&#xA; output_row.LatestActivitySLIC = row3.LatestActivitySLIC;&#xD;&#xA; output_row.LatestActivityCountry = row3.LatestActivityCountry;&#xD;&#xA; output_row.LatestActivityState = row3.LatestActivityState;&#xD;&#xA; output_row.ImportDT = importDT;&#xD;&#xA; output_row.ImportTime_ms = row3.ImportTime_ms;&#xD;&#xA; output_row.insert_timestamp_cluster_min = row3.insert_timestamp_cluster_min;&#xD;&#xA; output_row.SP_Source = row3.SP_Source;&#xD;&#xA; output_row.LatestActLogicFlg = row3.LatestActLogicFlg;&#xD;&#xA;&#xD;&#xA; // --- Derived columns (Qlik's Date()/Time() on the shifted timestamp) ---&#xD;&#xA; output_row.UpdateDate = new java.sql.Date(shiftedMillis);&#xD;&#xA; output_row.UpdateTime = new java.sql.Time(shiftedMillis);&#xD;&#xA;&#xD;&#xA;} catch (NumberFormatException e) {&#xD;&#xA; System.err.println(&quot;Failed to parse epoch timestamp for PackageId &quot;&#xD;&#xA;     + row3.PackageId + &quot;: &quot; + e.getMessage());&#xD;&#xA; // decide here whether to skip the row (return without setting output) or rethrow&#xD;&#xA; throw new RuntimeException(e);&#xD;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_3">
