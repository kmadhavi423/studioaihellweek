  <note opaque="true" posX="1040" posY="-120" sizeHeight="80" sizeWidth="120" text="CREATE SEQUENCE SEQ_DI_BATCH_ID&#xD;&#xA;    START WITH 1&#xD;&#xA;    INCREMENT BY 1&#xD;&#xA;    NOCACHE;&#xD;&#xA;&#xD;&#xA;CREATE TABLE ETL_CONTROL (&#xD;&#xA;    -- Identifikation&#xD;&#xA;    DI_BATCH_ID     NUMBER NOT NULL,&#xD;&#xA;    JOB_NAME        VARCHAR2(255) NOT NULL,&#xD;&#xA;    PARENT_JOB_NAME   VARCHAR2(255),&#xD;&#xA;    DI_JOB_ID         VARCHAR2(50),&#xD;&#xA;    &#xD;&#xA;    -- Zeitliche Überwachung&#xD;&#xA;    START_TIME      TIMESTAMP DEFAULT CURRENT_TIMESTAMP,&#xD;&#xA;    END_TIME        TIMESTAMP,              -- Wird am Ende des Master-Jobs gesetzt&#xD;&#xA;    &#xD;&#xA;    -- Metriken (Data Lineage)&#xD;&#xA;    INPUT_COUNT     NUMBER DEFAULT 0,       -- Gelesene Zeilen aus der Quelle&#xD;&#xA;    OUTPUT_COUNT    NUMBER DEFAULT 0,       -- Erfolgreich geschriebene Zeilen (Staging/Core)&#xD;&#xA;    REJECT_COUNT    NUMBER DEFAULT 0,       -- Ausgefilterte/Fehlerhafte Zeilen&#xD;&#xA;    &#xD;&#xA;    -- Status&#xD;&#xA;    STATUS          VARCHAR2(20) DEFAULT 'RUNNING', -- RUNNING, SUCCESS, FAILURE&#xD;&#xA;    &#xD;&#xA;    CONSTRAINT PK_ETL_CONTROL PRIMARY KEY (DI_BATCH_ID, JOB_NAME)&#xD;&#xA;);">
    <elementParameter field="COLOR" name="NOTE_COLOR" value="237;201;122"/>
  </note>
