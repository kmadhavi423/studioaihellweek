  <node componentName="tPostgresqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="80" posY="320">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tPostgresqlInput" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.102 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Databases/DB Specifics/PostgreSQL" show="false"/>
    <elementParameter field="CHECK" name="START" value="true" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="true" show="false"/>
    <elementParameter field="CHECK" name="SUBTREE_START" value="true" show="false"/>
    <elementParameter field="CHECK" name="END_OF_FLOW" value="false" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tPostgresqlInput" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Program Files (x86)\Talend-Studio\studio\configuration\lib\java" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="V9_X" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="PostgreSQL" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;5432&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v2:SLIKftq2ccpDG8BPHCcnNtPkl+8ZnagaVGaeaHIx" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT &quot; +&#xD;&#xA;&quot;  s.*, &quot; +&#xD;&#xA;&quot;  RIGHT(s.\&quot;PkgRef3\&quot;, 3) AS \&quot;Ref3Value\&quot;, &quot; +&#xD;&#xA;&quot;  CASE WHEN LEFT(s.\&quot;TrackingNumber\&quot;,2)='1Z' &quot; +&#xD;&#xA;&quot;       THEN SUBSTRING(s.\&quot;TrackingNumber\&quot; FROM 9 FOR 2) &quot; +&#xD;&#xA;&quot;       ELSE '&lt;Blank>' END AS \&quot;OneZServiceCode\&quot;, &quot; +&#xD;&#xA;&quot;  CASE WHEN s.\&quot;LastExceptionDate\&quot; IS NULL THEN 'N' ELSE 'Y' END AS \&quot;ExceptionInd\&quot;, &quot; +&#xD;&#xA;&quot;  CASE WHEN s.\&quot;DeliveryDate\&quot; IS NOT NULL THEN 'Delivered' ELSE 'Transit' END AS \&quot;DeliveryStatus\&quot;, &quot; +&#xD;&#xA;&quot;  CASE WHEN s.\&quot;ClientID\&quot; = 5052 &quot; +&#xD;&#xA;&quot;       THEN RIGHT(s.\&quot;ShipperNumber\&quot;,6) || REGEXP_REPLACE(s.\&quot;PkgRef2\&quot;, '[^0-9]', '', 'g') &quot; +&#xD;&#xA;&quot;       ELSE RIGHT(s.\&quot;ShipperNumber\&quot;,6) END AS \&quot;StoreName\&quot;, &quot; +&#xD;&#xA;&quot;  CASE WHEN LEFT(s.\&quot;PkgRef3\&quot;,3) IN ('001','002') THEN 'Low' &quot; +&#xD;&#xA;&quot;       WHEN LEFT(s.\&quot;PkgRef3\&quot;,3) = '003' THEN 'Mid' &quot; +&#xD;&#xA;&quot;       WHEN LEFT(s.\&quot;PkgRef3\&quot;,3) IN ('004','005') THEN 'High' &quot; +&#xD;&#xA;&quot;       ELSE NULL END AS \&quot;Value1\&quot;, &quot; +&#xD;&#xA;&quot;  COALESCE(CASE WHEN s.\&quot;AccessDryIce\&quot;='1' THEN 'ICE' ELSE '' END &quot; +&#xD;&#xA;&quot;        || CASE WHEN s.\&quot;AccessHazMat\&quot;='1' THEN 'HAZ' ELSE '' END &quot; +&#xD;&#xA;&quot;        || s.\&quot;UPSPremierdesc\&quot;, '') AS \&quot;Accessorial\&quot;, &quot; +&#xD;&#xA;&quot;  LEFT(s.\&quot;DROPZip\&quot;, 5) AS \&quot;Drop_UPS_Center\&quot;, &quot; +&#xD;&#xA;&quot;  CASE WHEN s.\&quot;ClientID\&quot; = 5160 THEN s.\&quot;ClientID\&quot;::text || '|' || RIGHT(s.\&quot;ShipperNumber\&quot;,6) &quot; +&#xD;&#xA;&quot;       ELSE s.\&quot;ClientID\&quot;::text || '|' || RIGHT(s.\&quot;PrincipalAccountNum\&quot;,6) END AS \&quot;KEYCLIENTID\&quot;, &quot; +&#xD;&#xA;&quot;  s.\&quot;LatestActivityDate\&quot;::text || ' ' || s.\&quot;LatestActivityTime\&quot; AS \&quot;LatestActivityDateTime\&quot;, &quot; +&#xD;&#xA;&quot;  s.\&quot;LatestActivityDate\&quot;::text || ' ' || s.\&quot;LatestActivityTime\&quot; || ' - ' || s.\&quot;LatestActivityLocation\&quot; &quot; +&#xD;&#xA;&quot;    || '  ' || s.\&quot;LatestActivityCountry\&quot; || ' - ' || s.\&quot;LatestActivityDesc\&quot; AS \&quot;LastActivity\&quot;, &quot; +&#xD;&#xA;&quot;  s.\&quot;LatestActivityLocation\&quot; || '  ' || s.\&quot;LatestActivityCountry\&quot; AS \&quot;LatestLocation\&quot;, &quot; +&#xD;&#xA;&quot;  s.\&quot;ManifestDate\&quot;::text || ' ' || s.\&quot;ManifestTime\&quot; AS \&quot;ManifestDateTime\&quot;, &quot; +&#xD;&#xA;&quot;  s.\&quot;FirstScanDate\&quot;::text || ' ' || s.\&quot;FirstScanTime\&quot; AS \&quot;FirstScanDateTime\&quot;, &quot; +&#xD;&#xA;&quot;  opm_origin.postal_code AS \&quot;OriginPostalCode\&quot;, &quot; +&#xD;&#xA;&quot;  opm_last_exc.state_code AS \&quot;LastExceptionState_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  opm_first_exc.state_code AS \&quot;FirstExceptionState_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  opm_latest_act.country_code AS \&quot;LatestActivityCountry_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  opm_latest_act.political_division AS \&quot;LatestActivityLocation_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  opm_latest_act.state_code AS \&quot;LatestActivityState_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  pt.pack_type AS \&quot;PackType\&quot;, &quot; +&#xD;&#xA;&quot;  sl.service_level AS \&quot;ServiceLevel_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  sl.service_group_code AS \&quot;ServiceGroupCode_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  sl.service_group_description AS \&quot;ServiceGroupDescription\&quot;, &quot; +&#xD;&#xA;&quot;  sl.service_level_description AS \&quot;ServiceLevelDescription_lookup\&quot;, &quot; +&#xD;&#xA;&quot;  rc_consignee.country_name AS \&quot;ConsigneeCountryName\&quot;, &quot; +&#xD;&#xA;&quot;  rc_consignee.cap_region AS \&quot;ConsigneeCAPRegion\&quot;, &quot; +&#xD;&#xA;&quot;  rc_origin.country_name AS \&quot;OriginCountryNm\&quot; &quot; +&#xD;&#xA;&quot;FROM \&quot;silver\&quot;.\&quot;starr_base\&quot; s &quot; +&#xD;&#xA;&quot;INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = s.\&quot;PackageID\&quot; &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;origin_postal_code_map\&quot; opm_origin     ON opm_origin.slic_number = s.\&quot;OriginSLIC\&quot; &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;origin_postal_code_map\&quot; opm_last_exc   ON opm_last_exc.slic_number = s.\&quot;LastExceptionSLIC\&quot; &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;origin_postal_code_map\&quot; opm_first_exc  ON opm_first_exc.slic_number = s.\&quot;FirstExceptionSLIC\&quot; &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;origin_postal_code_map\&quot; opm_latest_act ON opm_latest_act.slic_number = s.\&quot;LatestActivitySLIC\&quot; &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;pack_type\&quot; pt ON pt.ref3_value = RIGHT(s.\&quot;PkgRef3\&quot;, 3) &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;service_level\&quot; sl &quot; +&#xD;&#xA;&quot;  ON sl.one_z_service_code = (CASE WHEN LEFT(s.\&quot;TrackingNumber\&quot;,2)='1Z' &quot; +&#xD;&#xA;&quot;                                    THEN SUBSTRING(s.\&quot;TrackingNumber\&quot; FROM 9 FOR 2) &quot; +&#xD;&#xA;&quot;                                    ELSE '&lt;Blank>' END) &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;region_codes\&quot; rc_consignee ON rc_consignee.country_code = s.\&quot;ConsigneeCountryCode\&quot; &quot; +&#xD;&#xA;&quot;LEFT JOIN \&quot;reference\&quot;.\&quot;region_codes\&quot; rc_origin ON rc_origin.country_code = s.\&quot;OriginCountryCC\&quot;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" value="postgres_id" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;&quot;" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="CHECK" name="USE_CURSOR" value="false"/>
    <elementParameter field="TEXT" name="CURSOR_SIZE" value="1000" show="false"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <elementParameter field="TABLE" name="TRIM_COLUMN">
      <elementValue elementRef="SCHEMA_COLUMN" value="PackageID" id="0"/>
      <elementValue elementRef="TRIM" value="false" id="1"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="ClientID" id="2"/>
      <elementValue elementRef="TRIM" value="false" id="3"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="TrackingNumber" id="4"/>
      <elementValue elementRef="TRIM" value="false" id="5"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="AccountType" id="6"/>
      <elementValue elementRef="TRIM" value="false" id="7"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="gmtOffset" id="8"/>
      <elementValue elementRef="TRIM" value="false" id="9"/>
