    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyyMMddHHmm&quot;);&#xD;&#xA;Date raw = sdf.parse(row1.max_update_time);&#xD;&#xA;Calendar cal = Calendar.getInstance();&#xD;&#xA;cal.setTime(raw);&#xD;&#xA;cal.add(Calendar.MINUTE, -120);&#xD;&#xA;context.multi_delivery_max_update_time = sdf.format(cal.getTime());&#xD;&#xA;System.out.println(&quot;multi_delivery_max_update_time &quot; + context.multi_delivery_max_update_time);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;Calendar cal1 = Calendar.getInstance();&#xD;&#xA;cal1.add(Calendar.MONTH, -7);&#xD;&#xA;cal1.set(Calendar.DAY_OF_MONTH, 1);&#xD;&#xA;context.multi_delivery_lookback_start_dt = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;).format(cal1.getTime());&#xD;&#xA;System.out.println(&quot;multi_delivery_lookback_start_dt &quot; + context.multi_delivery_lookback_start_dt);&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.util.Date;&#xD;&#xA;import java.util.Calendar;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
