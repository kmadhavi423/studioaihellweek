    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT * FROM (&#xD;&#xA;  SELECT *,&#xD;&#xA;    ROW_NUMBER() OVER (&#xD;&#xA;      PARTITION BY ClientID, TrackingNumber&#xD;&#xA;      ORDER BY PARSE_DATETIME('%m/%d/%Y %H:%M:%S',&#xD;&#xA;                 CONCAT(CAST(ActivityDate AS STRING), ' ', REPLACE(ActivityTime, '.', ':'))) DESC,&#xD;&#xA;               ImportTime_ms DESC&#xD;&#xA;    ) AS rnk&#xD;&#xA;  FROM `fpgproj-309517.HR.general_feed_stub` WHERE ( insert_timestamp_cluster_min > '&quot;+context.gen_max_update_time+&quot;'&#xD;&#xA;    AND TenantID = &quot;+context.tenant_vibe+&quot;&#xD;&#xA;)&#xD;&#xA;)&#xD;&#xA;WHERE ClientID &lt;> 4763 AND ClientID &lt;> 5160 AND reasonCodeRddVisibility IS NOT NULL&quot;"/>
