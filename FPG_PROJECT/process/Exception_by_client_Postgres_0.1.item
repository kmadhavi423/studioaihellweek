    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT * FROM (&#xD;&#xA;  SELECT *,&#xD;&#xA;    ROW_NUMBER() OVER (&#xD;&#xA;      PARTITION BY ClientID, PackageID&#xD;&#xA;      ORDER BY PARSE_DATETIME('%m/%d/%Y %H:%M:%S',&#xD;&#xA;                 CONCAT(CAST(DelDate AS STRING), ' ', REPLACE(DelDate_Time, '.', ':'))) DESC,&#xD;&#xA;               ImportTime_ms DESC&#xD;&#xA;    ) AS rnk&#xD;&#xA;  FROM `fpgproj-309517.HR.delivery_feed_stub` &#xD;&#xA;  WHERE    ( insert_timestamp_cluster_min > '&quot;+context.del_max_update_time+&quot;'&#xD;&#xA;    AND TenantID = &quot;+context.tenant_vibe+&quot;&#xD;&#xA;)&#xD;&#xA;)&#xD;&#xA;WHERE ClientID &lt;> 4763 AND ClientID &lt;> 5160 AND DelActRecordCd = 'NOT' AND AccountType IS NOT NULL&quot;"/>
