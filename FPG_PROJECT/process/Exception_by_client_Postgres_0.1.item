    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//cityCapitalized&#xD;&#xA;String cityCapitalized = null;&#xD;&#xA;if (row4.City != null) {&#xD;&#xA; StringBuilder sb = new StringBuilder();&#xD;&#xA; for (String word : row4.City.toLowerCase().split(&quot; &quot;)) {&#xD;&#xA;     if (word.length() > 0) {&#xD;&#xA;         sb.append(Character.toUpperCase(word.charAt(0))).append(word.substring(1)).append(&quot; &quot;);&#xD;&#xA;     }&#xD;&#xA; }&#xD;&#xA; cityCapitalized = sb.toString().trim();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//ActCode trimmed&#xD;&#xA;String activityCodeTrimmed = (row4.ActCode != null) ? row4.ActCode.trim() : null;&#xD;&#xA;&#xD;&#xA;//ExcDT parsed&#xD;&#xA;SimpleDateFormat delDateFmt = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;);&#xD;&#xA;Date excDTParsed = null;&#xD;&#xA;if (row4.DelDate != null) {&#xD;&#xA; try { excDTParsed = delDateFmt.parse(row4.DelDate); }&#xD;&#xA; catch (ParseException e) { throw new RuntimeException(&quot;Bad DelDate: &quot; + row4.DelDate, e); }&#xD;&#xA;}&#xD;&#xA;row7.ActivityType = row4.ActivityType;&#xD;&#xA;row7.AccountType = row4.AccountType;&#xD;&#xA;row7.billToAccountNumber = row4.billToAccountNumber;&#xD;&#xA;row7.reasonCodeRddVisibility = row4.reasonCodeRddVisibility;&#xD;&#xA;row7.ClientID = row4.ClientID;&#xD;&#xA;row7.DelDate = row4.DelDate;&#xD;&#xA;row7.DelDate_Time = row4.DelDate_Time;&#xD;&#xA;row7.DelTypeID = row4.DelTypeID;&#xD;&#xA;row7.ImportDT = row4.ImportDT;&#xD;&#xA;row7.ImportTime = row4.ImportTime;&#xD;&#xA;row7.ImportTime_ms = row4.ImportTime_ms;&#xD;&#xA;row7.PackageID = row4.PackageID;&#xD;&#xA;row7.ISO = row4.ISO;&#xD;&#xA;row7.Tenant = row4.Tenant;&#xD;&#xA;row7.TrackingNumber = row4.TrackingNumber;&#xD;&#xA;row7.insert_timestamp_cluster_min = row4.insert_timestamp_cluster_min;&#xD;&#xA;row7.altTrackNr = row4.altTrackNr;&#xD;&#xA;row7.SLIC = row4.SLIC;&#xD;&#xA;row7.STATE = row4.STATE;&#xD;&#xA;row7.gmtOffset = row4.gmtOffset;&#xD;&#xA;row7.rtsInd = row4.rtsInd;&#xD;&#xA;row7.returnServiceIndictr = row4.returnServiceIndictr;&#xD;&#xA;row7.DelActRecordCd = row4.DelActRecordCd;&#xD;&#xA;row7.rnk = row4.rnk;&#xD;&#xA;//Assign every row4 column through to row5, plus the three new ones&#xD;&#xA;row7.ActCode = row4.ActCode;&#xD;&#xA;row7.City = row4.City;&#xD;&#xA;//... every other row4 column, unchanged ...&#xD;&#xA;row7.cityCapitalized = cityCapitalized;&#xD;&#xA;row7.activityCodeTrimmed = activityCodeTrimmed;&#xD;&#xA;row7.excDTParsed = excDTParsed;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;"/>
