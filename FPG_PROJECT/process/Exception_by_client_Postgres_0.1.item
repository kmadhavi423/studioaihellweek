    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyyMMddHHmm&quot;);&#xD;&#xA;Date raw = sdf.parse(row1.max_update_time);&#xD;&#xA;Calendar cal = Calendar.getInstance();&#xD;&#xA;cal.setTime(raw);&#xD;&#xA;cal.add(Calendar.MINUTE, -120);&#xD;&#xA;String buffered = sdf.format(cal.getTime());&#xD;&#xA;&#xD;&#xA;if (&quot;Exc&quot;.equals(row1.source_system)) context.exc_max_update_time = buffered;&#xD;&#xA;else if (&quot;Del&quot;.equals(row1.source_system)) context.del_max_update_time = buffered;&#xD;&#xA;else if (&quot;Gen&quot;.equals(row1.source_system)) context.gen_max_update_time = buffered;&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;exc_max_update_time &quot; + context.exc_max_update_time);&#xD;&#xA;System.out.println(&quot;del_max_update_time &quot; + context.del_max_update_time);&#xD;&#xA;System.out.println(&quot;gen_max_update_time &quot; + context.gen_max_update_time);&#xD;&#xA;&#xD;&#xA;Calendar cal1 = Calendar.getInstance();&#xD;&#xA;cal1.add(Calendar.MONTH, -7);&#xD;&#xA;cal1.set(Calendar.DAY_OF_MONTH, 1);&#xD;&#xA;context.exception_lookback_start_dt = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;).format(cal1.getTime());&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;exception_lookback_start_dt &quot; + context.exception_lookback_start_dt);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;&#xD;&#xA;import java.util.Calendar;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1"/>
  </node>
