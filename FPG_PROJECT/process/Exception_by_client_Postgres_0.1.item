    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//ExcDT = Date(date#(ActivityDate, 'MM/DD/YYYY'))&#xD;&#xA;SimpleDateFormat activityDateFmt = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;);&#xD;&#xA;Date excDT = null;&#xD;&#xA;if (row5.ActivityDate != null) {&#xD;&#xA; try { excDT = activityDateFmt.parse(row5.ActivityDate); }&#xD;&#xA; catch (ParseException e) { throw new RuntimeException(&quot;Bad ActivityDate: &quot; + row5.ActivityDate, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//ExcDT_Time — OPTION A: straight passthrough, matches the script literally&#xD;&#xA;&#xD;&#xA;SimpleDateFormat fullDtFmt = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);&#xD;&#xA;SimpleDateFormat outTimeFmt = new SimpleDateFormat(&quot;HH.mm.ss&quot;);&#xD;&#xA;String excDTTime = null;&#xD;&#xA;if (row5.GenActivityDateTime != null) {&#xD;&#xA;    try { excDTTime = outTimeFmt.format(fullDtFmt.parse(row5.GenActivityDateTime)); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad GenActivityDateTime: &quot; + row5.GenActivityDateTime, e); }&#xD;&#xA;}&#xD;&#xA;//ExcDT_Time — OPTION B: only use this if GenActivityDateTime turns out to be a&#xD;&#xA;//full datetime string, not already time-only (see flag above)&#xD;&#xA;//SimpleDateFormat fullDtFmt = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);&#xD;&#xA;//SimpleDateFormat outTimeFmt = new SimpleDateFormat(&quot;HH.mm.ss&quot;);&#xD;&#xA;//String excDTTime = null;&#xD;&#xA;//if (row5.GenActivityDateTime != null) {&#xD;&#xA;//  try { excDTTime = outTimeFmt.format(fullDtFmt.parse(row5.GenActivityDateTime)); }&#xD;&#xA;//  catch (ParseException e) { throw new RuntimeException(&quot;Bad GenActivityDateTime: &quot; + row5.GenActivityDateTime, e); }&#xD;&#xA;//}&#xD;&#xA;&#xD;&#xA;row10.PackageID = row5.PackageID;&#xD;&#xA;row10.TrackingNumber = row5.TrackingNumber;&#xD;&#xA;row10.ClientID = row5.ClientID;&#xD;&#xA;row10.ActivityCode = row5.ActivityCode;&#xD;&#xA;row10.billToAccountNumber = row5.billToAccountNumber;&#xD;&#xA;row10.ActivityStatusReasonCode = row5.ActivityStatusReasonCode;&#xD;&#xA;row10.CurrentStatusDescription = row5.CurrentStatusDescription;&#xD;&#xA;row10.CurrentStatusShortDesc = row5.CurrentStatusShortDesc;&#xD;&#xA;row10.ImportDT = row5.ImportDT;&#xD;&#xA;row10.ImportTime_ms = row5.ImportTime_ms;&#xD;&#xA;row10.SLIC = row5.SLIC;&#xD;&#xA;row10.GenActivityCity = row5.GenActivityCity;&#xD;&#xA;row10.GenActivityStateProv = row5.GenActivityStateProv;&#xD;&#xA;row10.gmtOffset = row5.gmtOffset;&#xD;&#xA;row10.insert_timestamp_cluster_min = row5.insert_timestamp_cluster_min;&#xD;&#xA;row10.rnk = row5.rnk;&#xD;&#xA;row10.excDT = excDT;&#xD;&#xA;row10.excDTTime = excDTTime;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_4">
      <column comment="" key="false" length="-1" name="AccountType" nullable="true" pattern="" precision="-1" sourceType="STRING" type="id_String" originalLength="-1" usefulColumn="true"/>
