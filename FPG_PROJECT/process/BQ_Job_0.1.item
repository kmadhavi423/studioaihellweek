    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;MERGE `fpgproj-309517.HR.etl_watermark` T&#xD;&#xA;USING (&#xD;&#xA;    SELECT 'orders' AS source_table, TIMESTAMP('&quot; + globalMap.get(&quot;new_watermark&quot;) + &quot;') AS last_watermark&#xD;&#xA;) S&#xD;&#xA;ON T.source_table = S.source_table&#xD;&#xA;WHEN MATCHED THEN&#xD;&#xA;  UPDATE SET last_watermark = S.last_watermark&#xD;&#xA;WHEN NOT MATCHED THEN&#xD;&#xA;  INSERT (source_table, last_watermark) VALUES (S.source_table, S.last_watermark)&quot;"/>
