    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="double epochSeconds = Double.parseDouble(input_row.max_update_time);&#xD;&#xA;java.util.Date maxDate = new java.util.Date((long)(epochSeconds * 1000));&#xD;&#xA;&#xD;&#xA;java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);&#xD;&#xA;sdf.setTimeZone(java.util.TimeZone.getTimeZone(&quot;UTC&quot;));&#xD;&#xA;globalMap.put(&quot;new_watermark&quot;, sdf.format(maxDate));&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;New watermark to store : &quot; + globalMap.get(&quot;new_watermark&quot;));"/>
