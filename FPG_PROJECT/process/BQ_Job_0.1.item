    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="double epochSeconds = Double.parseDouble(input_row.last_watermark);&#xD;&#xA;context.last_update_time = new java.util.Date((long)(epochSeconds * 1000));&#xD;&#xA;context.current_run_updatetime = TalendDate.getCurrentDate();&#xD;&#xA;&#xD;&#xA;java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);&#xD;&#xA;sdf.setTimeZone(java.util.TimeZone.getTimeZone(&quot;UTC&quot;));&#xD;&#xA;globalMap.put(&quot;last_watermark_str&quot;, sdf.format(context.last_update_time));&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Last Success : &quot; + sdf.format(context.last_update_time));&#xD;&#xA;System.out.println(&quot;Current Run  : &quot; + sdf.format(context.current_run_updatetime));"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="last_watermark" nullable="true" pattern="&quot;yyyy-MM-dd HH:mm:ss.SSSSSS&quot;" precision="-1" sourceType="TIMESTAMP" type="id_Date" originalLength="-1" usefulColumn="true"/>
    </metadata>
