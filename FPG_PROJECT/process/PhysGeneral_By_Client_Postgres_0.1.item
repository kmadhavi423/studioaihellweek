    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;&#xD;&#xA;SimpleDateFormat dateInFmt  = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;);&#xD;&#xA;SimpleDateFormat dateOutFmt = new SimpleDateFormat(&quot;yyyy/MM/dd&quot;);&#xD;&#xA;SimpleDateFormat timeInFmt  = new SimpleDateFormat(&quot;HH.mm.ss&quot;);&#xD;&#xA;SimpleDateFormat timeOutFmt = new SimpleDateFormat(&quot;HHmmss&quot;);&#xD;&#xA;&#xD;&#xA;// --- pass every existing column straight through, unchanged ---&#xD;&#xA;output_row.ClientID                     = row3.ClientID;&#xD;&#xA;output_row.TrackingNumber               = row3.TrackingNumber;&#xD;&#xA;output_row.PackageID                    = row3.PackageID;&#xD;&#xA;output_row.AccountType                  = row3.AccountType;&#xD;&#xA;output_row.ActivityCode                 = row3.ActivityCode;&#xD;&#xA;output_row.ActivityType                 = row3.ActivityType;&#xD;&#xA;output_row.ActivityDate                 = row3.ActivityDate;&#xD;&#xA;output_row.ActivityTime                 = row3.ActivityTime;&#xD;&#xA;output_row.logicalScan                  = row3.logicalScan;&#xD;&#xA;output_row.ActivityCodeDesc             = row3.ActivityCodeDesc;&#xD;&#xA;output_row.gmtOffset                    = row3.gmtOffset;&#xD;&#xA;output_row.SLIC                         = row3.SLIC;&#xD;&#xA;output_row.ConsigneeSLIC                = row3.ConsigneeSLIC;&#xD;&#xA;output_row.ServiceLevelName             = row3.ServiceLevelName;&#xD;&#xA;output_row.ServiceLevelDescription      = row3.ServiceLevelDescription;&#xD;&#xA;output_row.ServiceGroup                 = row3.ServiceGroup;&#xD;&#xA;output_row.shipperAccount               = row3.shipperAccount;&#xD;&#xA;output_row.ImportDT                     = row3.ImportDT;&#xD;&#xA;output_row.ImportTime_ms                = row3.ImportTime_ms;&#xD;&#xA;output_row.insert_timestamp_cluster_min = row3.insert_timestamp_cluster_min;&#xD;&#xA;&#xD;&#xA;// --- computed date/time fields, matching staging.physical_activity's expected shapes ---&#xD;&#xA;try {&#xD;&#xA;    Date parsedDate = dateInFmt.parse(row3.ActivityDate);&#xD;&#xA;    output_row.FirstPhysicalDate    = dateOutFmt.format(parsedDate);   // String, 'yyyy/MM/dd'&#xD;&#xA;    output_row.MinPhysicalScanDate  = parsedDate;                      // Date&#xD;&#xA;} catch (ParseException e) {&#xD;&#xA;    output_row.FirstPhysicalDate   = null;&#xD;&#xA;    output_row.MinPhysicalScanDate = null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;try {&#xD;&#xA;    output_row.FirstPhysicalTime = timeOutFmt.format(timeInFmt.parse(row3.ActivityTime));  // String, 'HHmmss'&#xD;&#xA;} catch (ParseException e) {&#xD;&#xA;    output_row.FirstPhysicalTime = null;&#xD;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;"/>
