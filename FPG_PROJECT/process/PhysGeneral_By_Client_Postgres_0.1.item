    <elementParameter field="CHECK" name="USE_LEGACY_SQL" value="false"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT * FROM ( &quot; +&#xD;&#xA;&quot;  SELECT *, &quot; +&#xD;&#xA;&quot;    CASE ActivityCode &quot; +&#xD;&#xA;&quot;      WHEN 'MV' THEN 'Voided Manifest' &quot; +&#xD;&#xA;&quot;      WHEN 'D'  THEN 'Delivery' &quot; +&#xD;&#xA;&quot;      WHEN 'X'  THEN 'Exception' &quot; +&#xD;&#xA;&quot;      ELSE ActivityCodeDesc &quot; +&#xD;&#xA;&quot;    END AS ActivityDescription, &quot; +&#xD;&#xA;&quot;    MAX(CASE WHEN ActivityCode IN ('PU','PC','PT') THEN ActivityDate END) &quot; +&#xD;&#xA;&quot;      OVER (PARTITION BY PackageID) AS PickupDate, &quot; +&#xD;&#xA;&quot;    MAX(CASE WHEN ActivityCode IN ('PU','PC','PT') THEN ActivityTime END) &quot; +&#xD;&#xA;&quot;      OVER (PARTITION BY PackageID) AS PickupTime, &quot; +&#xD;&#xA;&quot;    DENSE_RANK() OVER ( &quot; +&#xD;&#xA;&quot;      PARTITION BY ClientID, PackageID &quot; +&#xD;&#xA;&quot;      ORDER BY gmtActivityDate, gmtActivityTime, ActivityType ASC, insert_timestamp_cluster_min &quot; +&#xD;&#xA;&quot;    ) AS rnk &quot; +&#xD;&#xA;&quot;  FROM `fpgproj-309517.HR.general_activity_feed_stub` &quot; +&#xD;&#xA;&quot;  WHERE insert_timestamp_cluster_min > '&quot;+context.origin_max_update_time+&quot;' &quot; +&#xD;&#xA;&quot;    AND TenantID = &quot;+context.tenant_vibe+&quot; &quot; +&#xD;&#xA;&quot;    AND ClientGroup = '&quot;+context.client_group+&quot;' &quot; +&#xD;&#xA;&quot;    AND ClientID &lt;> 4763 AND ClientID &lt;> 5160 &quot; +&#xD;&#xA;&quot;    AND ActivityCode &lt;> 'SP' AND ActivityCode &lt;> 'BR' AND ActivityCode &lt;> 'PL' &quot; +&#xD;&#xA;&quot;    AND AccountType IS NOT NULL &quot; +&#xD;&#xA;&quot;) &quot; +&#xD;&#xA;&quot;WHERE rnk = 1&quot;"/>
    <elementParameter field="CLOSED_LIST" name="RESULT_SIZE" value="SMALL"/>
    <elementParameter field="CHECK" name="USE_REGION_ENDPOINT" value="false"/>
    <elementParameter field="TEXT" name="REGION_ENDPOINT_BQ" value="&quot;https://bigquery.googleapis.com&quot;" show="false"/>
    <elementParameter field="FILE" name="TOKEN_NAME" value="&quot;C:/Program Files (x86)/Talend-Studio/studio/workspace/token.properties&quot;" show="false"/>
    <elementParameter field="CHECK" name="ADVANCED_SEPARATOR" value="false"/>
