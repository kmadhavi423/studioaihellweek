    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyyMMddHHmm&quot;);&#xD;&#xA;Date raw = sdf.parse(row1.max_update_time);&#xD;&#xA;Calendar cal = Calendar.getInstance();&#xD;&#xA;cal.setTime(raw);&#xD;&#xA;cal.add(Calendar.MINUTE, -120);&#xD;&#xA;String buffered = sdf.format(cal.getTime());&#xD;&#xA;&#xD;&#xA;if (&quot;Physical&quot;.equals(row1.extract_name)){&#xD;&#xA;&#x9;context.physical_max_update_time = buffered;}&#xD;&#xA;else if (&quot;Origin&quot;.equals(row1.extract_name)){ &#xD;&#xA;&#x9;context.origin_max_update_time = buffered;}&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;physical_max_update_time &quot; + context.physical_max_update_time);&#xD;&#xA;System.out.println(&quot;origin_max_update_time &quot; + context.origin_max_update_time);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.util.Date;&#xD;&#xA;import java.util.Calendar;&#xD;&#xA;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1"/>
  </node>
