    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJavaRow" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.101 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Custom_Code" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="false" show="false"/>
    <elementParameter field="CHECK" name="SUBTREE_START" value="true" show="false"/>
    <elementParameter field="CHECK" name="END_OF_FLOW" value="false" show="false"/>
    <elementParameter field="CHECK" name="ACTIVATE" value="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tJavaRow" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Program Files (x86)\Talend-Studio\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;// ===== Shared date parser for String-typed BQ date columns =====&#xD;&#xA;// CONFIRM this pattern against a real row before trusting it — BigQuery's&#xD;&#xA;// DATE columns typically stringify as 'yyyy-MM-dd', but verify.&#xD;&#xA;SimpleDateFormat bqDateFmt = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);&#xD;&#xA;&#xD;&#xA;// committedRSDD, committedSDD, pickupDate, plannedRSDD, plannedSDD, VoidDate&#xD;&#xA;// are all String in this schema — parse each with the same helper pattern.&#xD;&#xA;Date committedRSDD = null;&#xD;&#xA;if (row3.committedRSDD != null) {&#xD;&#xA;    try { committedRSDD = bqDateFmt.parse(row3.committedRSDD); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad committedRSDD: &quot; + row3.committedRSDD, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Date committedSDD = null;&#xD;&#xA;if (row3.committedSDD != null) {&#xD;&#xA;    try { committedSDD = bqDateFmt.parse(row3.committedSDD); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad committedSDD: &quot; + row3.committedSDD, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Date pickupDateParsed = null;&#xD;&#xA;if (row3.pickupDate != null) {&#xD;&#xA;    try { pickupDateParsed = bqDateFmt.parse(row3.pickupDate); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad pickupDate: &quot; + row3.pickupDate, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Date plannedRSDD = null;&#xD;&#xA;if (row3.plannedRSDD != null) {&#xD;&#xA;    try { plannedRSDD = bqDateFmt.parse(row3.plannedRSDD); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad plannedRSDD: &quot; + row3.plannedRSDD, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Date plannedSDD = null;&#xD;&#xA;if (row3.plannedSDD != null) {&#xD;&#xA;    try { plannedSDD = bqDateFmt.parse(row3.plannedSDD); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad plannedSDD: &quot; + row3.plannedSDD, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Date voidDateParsed = null;&#xD;&#xA;if (row3.VoidDate != null) {&#xD;&#xA;    try { voidDateParsed = bqDateFmt.parse(row3.VoidDate); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad VoidDate: &quot; + row3.VoidDate, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// SDDDate = Date(date#(Alt(committedSDD, plannedSDD)))&#xD;&#xA;// Alt() in Qlik picks the first value that's already a valid representation of the&#xD;&#xA;// target type — here that's &quot;first non-null, already-parsed Date&quot;, so coalesce&#xD;&#xA;// on the two Date objects we just parsed, not on the raw strings.&#xD;&#xA;Date sddDate = (committedSDD != null) ? committedSDD : plannedSDD;&#xD;&#xA;&#xD;&#xA;// PrincipalAccountNum = text(Mid(PrincipalAccountNum, 5))  -- Qlik Mid() is 1-indexed&#xD;&#xA;String principalAccountNum = (row3.PrincipalAccountNum != null &amp;&amp; row3.PrincipalAccountNum.length() >= 5)&#xD;&#xA;    ? row3.PrincipalAccountNum.substring(4) : row3.PrincipalAccountNum;&#xD;&#xA;&#xD;&#xA;// ShipperNumber = text(Mid(TPackage_Shipper, 5))&#xD;&#xA;String shipperNumber = (row3.TPackage_Shipper != null &amp;&amp; row3.TPackage_Shipper.length() >= 5)&#xD;&#xA;    ? row3.TPackage_Shipper.substring(4) : row3.TPackage_Shipper;&#xD;&#xA;&#xD;&#xA;// ShipperCountryCode = alt(TManifest_ShipperISO, ManCountryCC)&#xD;&#xA;String shipperCountryCode = (row3.TManifest_ShipperISO != null &amp;&amp; !row3.TManifest_ShipperISO.isEmpty())&#xD;&#xA;    ? row3.TManifest_ShipperISO : row3.ManCountryCC;&#xD;&#xA;&#xD;&#xA;// shipperAccount = text(upper(shipperAccount))&#xD;&#xA;String shipperAccountUpper = (row3.shipperAccount != null) ? row3.shipperAccount.toUpperCase() : null;&#xD;&#xA;&#xD;&#xA;// billToAccount = text(upper(billToAccount))&#xD;&#xA;String billToAccountUpper = (row3.billToAccount != null) ? row3.billToAccount.toUpperCase() : null;&#xD;&#xA;&#xD;&#xA;// ManifestDate = Date(date#(LocalManDate, 'MM/DD/YYYY'))&#xD;&#xA;SimpleDateFormat mdFmt = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;);&#xD;&#xA;Date manifestDate = null;&#xD;&#xA;if (row3.LocalManDate != null) {&#xD;&#xA;    try { manifestDate = mdFmt.parse(row3.LocalManDate); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad LocalManDate: &quot; + row3.LocalManDate, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// ManifestTime = Time(Time#(LocalManTime, 'hh.mm.ss'), 'hhmmss')&#xD;&#xA;SimpleDateFormat inTimeFmt = new SimpleDateFormat(&quot;HH.mm.ss&quot;);&#xD;&#xA;SimpleDateFormat outTimeFmt = new SimpleDateFormat(&quot;HHmmss&quot;);&#xD;&#xA;String manifestTime = null;&#xD;&#xA;if (row3.LocalManTime != null) {&#xD;&#xA;    try { manifestTime = outTimeFmt.format(inTimeFmt.parse(row3.LocalManTime)); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad LocalManTime: &quot; + row3.LocalManTime, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// ===== Field assignments, in the same order as the Qlik LOAD statement =====&#xD;&#xA;row4.PackageID = row3.PackageId;&#xD;&#xA;row4.AccountType = row3.AccountType;&#xD;&#xA;row4.TrackingNumber = row3.TPackage_TrackingNumber;&#xD;&#xA;row4.Weight = row3.ActualPkgWeightLBS;                              // Double, pass-through&#xD;&#xA;row4.BillToOption = row3.BillToOption;&#xD;&#xA;row4.committedRSDD = committedRSDD;&#xD;&#xA;row4.committedSDD = committedSDD;&#xD;&#xA;row4.Committime = row3.commitTime;&#xD;&#xA;row4.DecValCurrency = row3.DecValCurrency;&#xD;&#xA;row4.WeightQualifier = row3.DimWeightQualif;&#xD;&#xA;row4.DWeight = row3.DWeight;                                        // Double, pass-through&#xD;&#xA;row4.GrsWeight = row3.GrsWeight;                                    // Double, pass-through&#xD;&#xA;row4.pickupDate = pickupDateParsed;&#xD;&#xA;row4.plannedRSDD = plannedRSDD;&#xD;&#xA;row4.plannedSDD = plannedSDD;&#xD;&#xA;row4.PreVoidPackage = row3.PreVoidPackage;&#xD;&#xA;row4.Service = row3.ServiceLevelName;&#xD;&#xA;row4.ServiceGroupCode = row3.ServiceGroupCode;&#xD;&#xA;row4.ServiceLevelDescription = row3.ServiceLevelDescription;&#xD;&#xA;row4.BillToAddress1 = row3.TManifest_BillingAddr1;&#xD;&#xA;row4.BillToCity = row3.TManifest_BillingCity;&#xD;&#xA;row4.BillToCountryCode = row3.TManifest_BillingISO;&#xD;&#xA;row4.BillToName1 = row3.TManifest_BillingName;&#xD;&#xA;row4.BillToName2 = row3.TManifest_BillingName2;&#xD;&#xA;row4.BillToPostalCode = row3.TManifest_BillingPC;&#xD;&#xA;row4.BillToAddress2 = row3.TManifest_BillingrAddr2;&#xD;&#xA;row4.BillToState = row3.TManifest_BillingState;&#xD;&#xA;row4.ConsigneeAddress1 = row3.TManifest_ConsAddr1;&#xD;&#xA;row4.ConsigneeAddress2 = row3.TManifest_ConsAddr2;&#xD;&#xA;row4.ConsigneeCity = row3.TManifest_ConsCity;&#xD;&#xA;row4.ConsigneeCountryCode = row3.TManifest_ConsigneeISO;&#xD;&#xA;row4.ConsigneeName1 = row3.TManifest_ConsName;&#xD;&#xA;row4.ConsigneePostalCode = row3.TManifest_ConsPC;&#xD;&#xA;row4.ConsigneeState = row3.TManifest_ConsState;&#xD;&#xA;row4.TManifest_DeclaredValue = row3.TManifest_DeclaredValue;        // Double, pass-through&#xD;&#xA;row4.PkgRef1 = row3.TManifest_PkgRef1;&#xD;&#xA;row4.PkgRef2 = row3.TManifest_PkgRef2;&#xD;&#xA;row4.PkgRef3 = row3.TManifest_PkgRef3;&#xD;&#xA;row4.PkgRef4 = row3.TManifest_PkgRef4;&#xD;&#xA;row4.PkgRef5 = row3.TManifest_PkgRef5;&#xD;&#xA;row4.ShipperAddress1 = row3.TManifest_ShipperAddr1;&#xD;&#xA;row4.ShipperAddress2 = row3.TManifest_ShipperAddr2;&#xD;&#xA;row4.ShipperCity = row3.TManifest_ShipperCity;&#xD;&#xA;row4.ShipperCountryCode = shipperCountryCode;&#xD;&#xA;row4.ShipperName1 = row3.TManifest_ShipperName;&#xD;&#xA;row4.ShipperName2 = row3.TManifest_ShipperName2;&#xD;&#xA;row4.ShipperPostalCode = row3.TManifest_ShipperPC;&#xD;&#xA;row4.ShipperState = row3.TManifest_ShipperState;&#xD;&#xA;row4.ShptRef1 = row3.TManifest_ShptRef1;&#xD;&#xA;row4.ShptRef2 = row3.TManifest_ShptRef2;&#xD;&#xA;row4.BillToShipperNumber = row3.TPackage_BillToAccount;&#xD;&#xA;//row4.TPackage_TrackingNumber = row3.TPackage_TrackingNumber;        // duplicate load, matches Qlik&#xD;&#xA;row4.VoidDate = voidDateParsed;&#xD;&#xA;row4.VoidIdentifier = row3.VoidIdentifier;                          // Boolean, pass-through&#xD;&#xA;row4.ImportTime_ms = row3.ImportTime_ms;&#xD;&#xA;row4.AccessDryIce = row3.AccessDryIce;&#xD;&#xA;row4.AccessHazMat = row3.AccessHazMat;&#xD;&#xA;row4.AccessPR = row3.AccessPR;&#xD;&#xA;row4.ClientID = row3.ClientID;                                      // Long, pass-through&#xD;&#xA;row4.shipperAccount = shipperAccountUpper;&#xD;&#xA;row4.PrincipalAccountNum = principalAccountNum;&#xD;&#xA;row4.SDDDate = sddDate;&#xD;&#xA;row4.PackageCount = row3.TotalPackages;                             // Long, pass-through&#xD;&#xA;row4.ConsigneeName2 = row3.TManifest_Attn;&#xD;&#xA;row4.TManifest_ConsPhoneNum = row3.TManifest_ConsPhoneNum;&#xD;&#xA;row4.ConsigneeSLIC = row3.ConsigneeSLIC;&#xD;&#xA;row4.ActualPackageDesc = row3.TManifest_ActualPackageDesc;&#xD;&#xA;row4.ShptLeadTrack = row3.ShptLeadTrack;&#xD;&#xA;row4.UPSPremierdesc = row3.UPSPremierdesc;&#xD;&#xA;row4.WaybillNumber = row3.WaybillNumber;&#xD;&#xA;row4.ShipperNumber = shipperNumber;&#xD;&#xA;row4.billToAccount = billToAccountUpper;&#xD;&#xA;row4.ManifestDate = manifestDate;&#xD;&#xA;row4.ManifestTime = manifestTime;&#xD;&#xA;row4.insert_timestamp_cluster_min = row3.insert_timestamp_cluster_min;&#xD;&#xA;row4.SP_Source = &quot;Man&quot;;&#xD;&#xA;row4.ImportTime = context.import_time_ref;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;&#xD;&#xA;"/>
