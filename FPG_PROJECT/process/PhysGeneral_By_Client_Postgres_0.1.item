    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT * FROM (&#xD;&#xA;  SELECT *,&#xD;&#xA;    CASE ActivityCode&#xD;&#xA;      WHEN 'MV' THEN 'Voided Manifest'&#xD;&#xA;      WHEN 'D'  THEN 'Delivery'&#xD;&#xA;      WHEN 'X'  THEN 'Exception'&#xD;&#xA;      ELSE ActivityCodeDesc&#xD;&#xA;    END AS ActivityDescription,&#xD;&#xA;    MAX(CASE WHEN ActivityCode IN ('PU','PC','PT') THEN ActivityDate END)&#xD;&#xA;      OVER (PARTITION BY PackageID) AS PickupDate,&#xD;&#xA;    MAX(CASE WHEN ActivityCode IN ('PU','PC','PT') THEN ActivityTime END)&#xD;&#xA;      OVER (PARTITION BY PackageID) AS PickupTime,&#xD;&#xA;    DENSE_RANK() OVER (&#xD;&#xA;      PARTITION BY ClientID, PackageID&#xD;&#xA;      ORDER BY gmtActivityDate, gmtActivityTime, ActivityType ASC, insert_timestamp_cluster_min&#xD;&#xA;    ) AS rnk&#xD;&#xA;  FROM `fpgproj-309517.HR.general_activity_feed_stub`  WHERE   &#xD;&#xA;  (     insert_timestamp_cluster_min > '&quot;+context.origin_max_update_time+&quot;'&#xD;&#xA;    AND TenantID = &quot;+context.tenant_vibe+&quot;&#xD;&#xA;)&#xD;&#xA;  WHERE ClientID &lt;> 4763 AND ClientID &lt;> 5160&#xD;&#xA;    AND ActivityCode &lt;> 'SP' AND ActivityCode &lt;> 'BR' AND ActivityCode &lt;> 'PL'&#xD;&#xA;    AND AccountType IS NOT NULL&#xD;&#xA;)&#xD;&#xA;WHERE rnk = 1:"/>
