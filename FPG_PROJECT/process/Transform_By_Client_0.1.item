    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; (\&quot;PackageID\&quot;) &quot;&#xD;&#xA;+&quot;SELECT DISTINCT \&quot;PackageID\&quot; FROM \&quot;staging\&quot;.\&quot;manifest_base\&quot; &quot;&#xD;&#xA;+&quot;  WHERE \&quot;insert_timestamp_cluster_min\&quot; > '&quot;+context.silver_max_update_time+&quot;' &quot;&#xD;&#xA;+&quot;UNION &quot;&#xD;&#xA;+&quot;SELECT DISTINCT \&quot;PackageID\&quot; FROM \&quot;staging\&quot;.\&quot;general_base\&quot; &quot;&#xD;&#xA;+&quot;  WHERE \&quot;insert_timestamp_cluster_min\&quot; > '&quot;+context.silver_max_update_time+&quot;' &quot;&#xD;&#xA;+&quot;UNION &quot;&#xD;&#xA;+&quot;SELECT DISTINCT \&quot;PackageID\&quot; FROM \&quot;staging\&quot;.\&quot;origin_activity\&quot; &quot;&#xD;&#xA;+&quot;  WHERE \&quot;insert_timestamp_cluster_min\&quot; > '&quot;+context.silver_max_update_time+&quot;' &quot;&#xD;&#xA;+&quot;UNION &quot;&#xD;&#xA;+&quot;SELECT DISTINCT \&quot;PackageID\&quot; FROM \&quot;staging\&quot;.\&quot;physical_activity\&quot; &quot;&#xD;&#xA;+&quot;  WHERE \&quot;insert_timestamp_cluster_min\&quot; > '&quot;+context.silver_max_update_time+&quot;' &quot;&#xD;&#xA;+&quot;UNION &quot;&#xD;&#xA;+&quot;SELECT DISTINCT \&quot;PackageID\&quot; FROM \&quot;staging\&quot;.\&quot;delivery_base\&quot; &quot;&#xD;&#xA;+&quot;  WHERE \&quot;insert_timestamp_cluster_min\&quot; > '&quot;+context.silver_max_update_time+&quot;' &quot;&#xD;&#xA;+&quot;UNION &quot;&#xD;&#xA;+&quot;SELECT DISTINCT \&quot;PackageId\&quot; FROM \&quot;staging\&quot;.\&quot;package_status_base\&quot; &quot;&#xD;&#xA;+&quot;  WHERE \&quot;insert_timestamp_cluster_min\&quot; > '&quot;+context.silver_max_update_time+&quot;' &quot;&#xD;&#xA;+&quot;UNION &quot;&#xD;&#xA;+&quot;SELECT DISTINCT \&quot;PackageID\&quot; FROM \&quot;staging\&quot;.\&quot;exception_current_by_package\&quot; &quot;&#xD;&#xA;+&quot;  WHERE \&quot;updated_at\&quot; > TO_TIMESTAMP('&quot;+context.silver_max_update_time+&quot;', 'YYYYMMDDHH24MI')&quot;"/>
