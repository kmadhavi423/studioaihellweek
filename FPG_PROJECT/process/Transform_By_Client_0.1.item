    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="SimpleDateFormat sdFmt = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;); // confirm actual format against real data&#xD;&#xA;Date plannedRSDDParsed = null;&#xD;&#xA;if (row3.plannedRSDD != null) {&#xD;&#xA;    try { plannedRSDDParsed = sdFmt.parse(row3.plannedRSDD); } catch (ParseException e) { /* leave null on bad data */ }&#xD;&#xA;}&#xD;&#xA;Date plannedSDDParsed = null;&#xD;&#xA;if (row3.plannedSDD != null) {&#xD;&#xA;    try { plannedSDDParsed = sdFmt.parse(row3.plannedSDD); } catch (ParseException e) { /* leave null on bad data */ }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// FirstPhysicalDate: physical_activity delivers this as String, not Date -- format below&#xD;&#xA;// is a placeholder (yyyy-MM-dd), NOT confirmed against real data. Pull real rows from&#xD;&#xA;// staging.physical_activity.&quot;FirstPhysicalDate&quot; and fix this pattern before this is trusted.&#xD;&#xA;SimpleDateFormat physDateFmt = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;); // CONFIRM against real data&#xD;&#xA;Date firstPhysicalDateParsed = null;&#xD;&#xA;if (row3.FirstPhysicalDate != null &amp;&amp; !row3.FirstPhysicalDate.trim().isEmpty()) {&#xD;&#xA;    try { firstPhysicalDateParsed = physDateFmt.parse(row3.FirstPhysicalDate.trim()); } catch (ParseException e) { /* leave null on bad data */ }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;List&lt;Date> candidates = Arrays.asList(&#xD;&#xA;    row3.committedSDD, plannedSDDParsed, row3.SDDDate,&#xD;&#xA;    row3.committedRSDD, plannedRSDDParsed, row3.finalMileRDD, row3.destinationRDD&#xD;&#xA;);&#xD;&#xA;Calendar sentinelCal = Calendar.getInstance();&#xD;&#xA;sentinelCal.set(1900, Calendar.JANUARY, 1, 0, 0, 0);&#xD;&#xA;sentinelCal.set(Calendar.MILLISECOND, 0);&#xD;&#xA;Date sentinel = sentinelCal.getTime();&#xD;&#xA;&#xD;&#xA;Date maxCandidate = sentinel;&#xD;&#xA;for (Date d : candidates) {&#xD;&#xA;    if (d != null &amp;&amp; d.after(maxCandidate)) {&#xD;&#xA;        maxCandidate = d;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;Date systemDueDate = maxCandidate.equals(sentinel) ? null : maxCandidate;&#xD;&#xA;&#xD;&#xA;Date dueDate = (row3.RSDDDate != null) ? row3.RSDDDate&#xD;&#xA;        : (row3.SDDDate != null) ? row3.SDDDate&#xD;&#xA;        : row3.RDDDate;&#xD;&#xA;&#xD;&#xA;// ConsigneeSLIC = numeric-safe Alt(ConsigneeSLIC_M, ConsigneeSLIC_G)&#xD;&#xA;String consigneeSlic = null;&#xD;&#xA;if (row3.ConsigneeSLIC_M != null &amp;&amp; row3.ConsigneeSLIC_M.matches(&quot;\\d+&quot;)) {&#xD;&#xA;    consigneeSlic = row3.ConsigneeSLIC_M;&#xD;&#xA;} else if (row3.ConsigneeSLIC_G != null &amp;&amp; row3.ConsigneeSLIC_G.matches(&quot;\\d+&quot;)) {&#xD;&#xA;    consigneeSlic = row3.ConsigneeSLIC_G;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;String spSource = row3.SP_Source_M;&#xD;&#xA;&#xD;&#xA;// LatestActivityDesc = IF(CurrentStatus='Delivered','Delivery',CurrentStatus)&#xD;&#xA;String latestActivityDesc = &quot;Delivered&quot;.equals(row3.CurrentStatus) ? &quot;Delivery&quot; : row3.CurrentStatus;&#xD;&#xA;&#xD;&#xA;// ----- Full passthrough -----&#xD;&#xA;row4.PackageID = row3.PackageID;&#xD;&#xA;row4.ClientID = row3.ClientID;&#xD;&#xA;row4.TrackingNumber = row3.TrackingNumber;&#xD;&#xA;row4.AccountType = row3.AccountType;&#xD;&#xA;String gmtOffset = (row3.gmtOffset_G != null) ? row3.gmtOffset_G&#xD;&#xA;        : (row3.gmtOffset_PS != null) ? String.valueOf(row3.gmtOffset_PS) : null;&#xD;&#xA;row4.ShipperNumber = row3.ShipperNumber;&#xD;&#xA;row4.ServiceGroupCode = row3.ServiceGroupCode;&#xD;&#xA;row4.PrincipalAccountNum = row3.PrincipalAccountNum;&#xD;&#xA;row4.SDDDate = row3.SDDDate;&#xD;&#xA;row4.RSDDDate = row3.RSDDDate;&#xD;&#xA;row4.RDDDate = row3.RDDDate;&#xD;&#xA;row4.DueDate = dueDate;&#xD;&#xA;row4.RTS_StatusInd = row3.rtsInd;&#xD;&#xA;row4.SystemDueDate = systemDueDate;&#xD;&#xA;row4.PreVoidPackage = row3.PreVoidPackage;&#xD;&#xA;row4.ReceivedByClarifiedSign = row3.ReceivedByClarifiedSign;&#xD;&#xA;row4.OriginSLIC = row3.OriginSLIC;&#xD;&#xA;row4.OriginCity = row3.OriginCity;&#xD;&#xA;row4.OriginState = row3.OriginState;&#xD;&#xA;row4.OriginCountryCC = row3.OriginCountryCC;&#xD;&#xA;row4.OriginDate = row3.OriginDate;&#xD;&#xA;row4.OriginTime = row3.OriginTime;&#xD;&#xA;row4.OriginOffset = row3.OriginOffset;&#xD;&#xA;row4.ManifestDate = row3.ManifestDate;&#xD;&#xA;row4.ManifestTime = row3.ManifestTime;&#xD;&#xA;row4.VoidDate = row3.VoidDate;&#xD;&#xA;row4.Weight = row3.Weight;&#xD;&#xA;row4.DWeight = row3.DWeight;&#xD;&#xA;row4.WeightQualifier = row3.WeightQualifier;&#xD;&#xA;row4.GrsWeight = row3.GrsWeight;&#xD;&#xA;row4.PackageCount = row3.PackageCount;&#xD;&#xA;row4.PickupDate = row3.PickupDate;&#xD;&#xA;row4.PickupTime = row3.PickupTime;&#xD;&#xA;row4.FirstActivity = row3.OriginFirstActivity;&#xD;&#xA;row4.FirstScanDate = row3.FirstScanDate;&#xD;&#xA;row4.FirstScanTime = row3.FirstScanTime;&#xD;&#xA;row4.LastExceptionDate = row3.LastExceptionDate;&#xD;&#xA;row4.LastExceptionTime = row3.LastExceptionTime;&#xD;&#xA;row4.LastExceptionUTCOffSet = row3.LastExceptionUTCOffSet;&#xD;&#xA;row4.LastExceptionCity = row3.LastExceptionCity;&#xD;&#xA;row4.LastExceptionSLIC = row3.LastExceptionSLIC;&#xD;&#xA;row4.LastExceptionState = row3.LastExceptionState;&#xD;&#xA;row4.LastExceptionCountry = row3.LastExceptionCountry;&#xD;&#xA;row4.LastExceptionStatusCode = row3.LastExceptionStatusCode;&#xD;&#xA;row4.LastExceptionStatusDesc = row3.LastExceptionStatusDesc;&#xD;&#xA;row4.LastStatusResolCdVIEWABLE = row3.LastStatusResolCdVIEWABLE;&#xD;&#xA;row4.LastExceptionReasonCode = row3.LastExceptionReasonCode;&#xD;&#xA;row4.LastExceptionReasonDesc = row3.LastExceptionReasonDesc;&#xD;&#xA;row4.LastExcReasonCdVIEWABLE = row3.LastExcReasonCdVIEWABLE;&#xD;&#xA;row4.altTrackNr = row3.altTrackNr;&#xD;&#xA;row4.LatestActivityCode = row3.LatestActivityCode;&#xD;&#xA;row4.LatestActivityDesc = latestActivityDesc;&#xD;&#xA;row4.LatestActivitySLIC = row3.LatestActivitySLIC;&#xD;&#xA;row4.LatestActivityState = row3.LatestActivityState;&#xD;&#xA;row4