&#xA;row4.FirstPhysActivityCode = row3.FirstPhysActivityCode;&#xD;&#xA;row4.FirstPhysicalDescription = row3.FirstPhysicalDescription;&#xD;&#xA;row4.FirstPhysicalDate = firstPhysicalDateParsed;&#xD;&#xA;row4.FirstPhysicalTime = row3.FirstPhysicalTime;&#xD;&#xA;row4.FirstPhysActGMTOffset = row3.FirstPhysActGMTOffset;&#xD;&#xA;row4.InnerULDNum = row3.InnerULDNum;&#xD;&#xA;row4.OriginSortSLIC = row3.OriginSortSLIC;&#xD;&#xA;row4.OriginCnyCd = row3.OriginCnyCd;&#xD;&#xA;row4.DestSortSlic = row3.DestSortSlic;&#xD;&#xA;row4.DestCnyCd = row3.DestCnyCd;&#xD;&#xA;row4.WaybillNumber = row3.WaybillNumber;&#xD;&#xA;row4.DecValCurrency = row3.DecValCurrency;&#xD;&#xA;row4.TManifest_DeclaredValue = row3.TManifest_DeclaredValue;&#xD;&#xA;row4.ActualPackageDesc = row3.ActualPackageDesc;&#xD;&#xA;row4.SP_Source = spSource;&#xD;&#xA;row4.DropOff_Date = row3.DropOff_Date;&#xD;&#xA;row4.DropOff_Time = row3.DropOff_Time;&#xD;&#xA;row4.DROPLocalCity = row3.DROPLocalCity;&#xD;&#xA;row4.DROPZip = row3.DROPZip;&#xD;&#xA;row4.DeliveryDate = row3.DeliveryDate;&#xD;&#xA;row4.DeliveryTime = row3.DeliveryTime;&#xD;&#xA;row4.DelOffSet = row3.DelOffSet;&#xD;&#xA;row4.DeliverySLIC = row3.DeliverySLIC;&#xD;&#xA;row4.DeliveryCity = row3.DeliveryCity;&#xD;&#xA;row4.DeliveryCountry = row3.DeliveryCountry;&#xD;&#xA;row4.DeliveryState = row3.DeliveryState;&#xD;&#xA;row4.DelActRecordCd = row3.DelActRecordCd;&#xD;&#xA;row4.DeliveryAddress1 = row3.DeliveryAddress1;&#xD;&#xA;row4.DeliveryAddress2 = row3.DeliveryAddress2;&#xD;&#xA;row4.DeliveryAddress3 = row3.DeliveryAddress3;&#xD;&#xA;row4.DeliveryCityFinal = row3.DeliveryCityFinal;&#xD;&#xA;row4.DeliveryStateFinal = row3.DeliveryStateFinal;&#xD;&#xA;row4.DeliveryPostalCode = row3.DeliveryPostalCode;&#xD;&#xA;row4.DeliveryCountryCode = row3.DeliveryCountryCode;&#xD;&#xA;row4.ResBus = row3.ResBus;&#xD;&#xA;row4.Service = row3.Service;&#xD;&#xA;row4.ServiceLevelDescription = row3.ServiceLevelDescription;"/>
