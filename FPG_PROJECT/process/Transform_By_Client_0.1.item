    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT &quot;&#xD;&#xA;+&quot;  m.\&quot;PackageID\&quot;, m.\&quot;ClientID\&quot;, m.\&quot;TrackingNumber\&quot;, m.\&quot;AccountType\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;ShipperNumber\&quot;, m.\&quot;ServiceGroupCode\&quot;, m.\&quot;PrincipalAccountNum\&quot;, m.\&quot;SDDDate\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;PreVoidPackage\&quot;, m.\&quot;ManifestDate\&quot;, m.\&quot;ManifestTime\&quot;, m.\&quot;VoidDate\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;Weight\&quot;, m.\&quot;DWeight\&quot;, m.\&quot;WeightQualifier\&quot;, m.\&quot;GrsWeight\&quot;, m.\&quot;PackageCount\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;ShptLeadTrack\&quot;, m.\&quot;ShptRef1\&quot;, m.\&quot;ShptRef2\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;PkgRef1\&quot;, m.\&quot;PkgRef2\&quot;, m.\&quot;PkgRef3\&quot;, m.\&quot;PkgRef4\&quot;, m.\&quot;PkgRef5\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;ShipperName1\&quot;, m.\&quot;ShipperAddress1\&quot;, m.\&quot;ShipperAddress2\&quot;, m.\&quot;ShipperCity\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;ShipperState\&quot;, m.\&quot;ShipperPostalCode\&quot;, m.\&quot;ShipperCountryCode\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;ConsigneeName1\&quot;, m.\&quot;ConsigneeAddress1\&quot;, m.\&quot;ConsigneeAddress2\&quot;, m.\&quot;ConsigneeCity\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;ConsigneeState\&quot;, m.\&quot;ConsigneePostalCode\&quot;, m.\&quot;ConsigneeCountryCode\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;TManifest_ConsPhoneNum\&quot;, m.\&quot;ConsigneeSLIC\&quot; AS \&quot;ConsigneeSLIC_M\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;BillToShipperNumber\&quot;, m.\&quot;BillToName1\&quot;, m.\&quot;BillToAddress1\&quot;, m.\&quot;BillToCity\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;BillToState\&quot;, m.\&quot;BillToPostalCode\&quot;, m.\&quot;BillToCountryCode\&quot;, m.\&quot;BillToOption\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;AccessDryIce\&quot;, m.\&quot;AccessHazMat\&quot;, m.\&quot;AccessPR\&quot;, m.\&quot;UPSPremierdesc\&quot;, m.\&quot;Committime\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;WaybillNumber\&quot;, m.\&quot;DecValCurrency\&quot;, m.\&quot;TManifest_DeclaredValue\&quot;, &quot;&#xD;&#xA;+&quot;  m.\&quot;ActualPackageDesc\&quot;, m.\&quot;SP_Source\&quot; AS \&quot;SP_Source_M\&quot;, &quot;&#xD;&#xA;+&quot;  g.\&quot;RSDDDate\&quot;, g.\&quot;RDDDate\&quot;, g.\&quot;DropOff_Date\&quot;, g.\&quot;DropOff_Time\&quot;, g.\&quot;gmtOffset\&quot; AS \&quot;gmtOffset_G\&quot;, &quot;&#xD;&#xA;+&quot;  g.\&quot;DROPLocalCity\&quot;, g.\&quot;DROPZip\&quot;, g.\&quot;ConsigneeSLIC\&quot; AS \&quot;ConsigneeSLIC_G\&quot;, &quot;&#xD;&#xA;+&quot;  g.\&quot;committedSDD\&quot;, g.\&quot;committedRSDD\&quot;, g.\&quot;finalMileRDD\&quot;, g.\&quot;destinationRDD\&quot;, &quot;&#xD;&#xA;+&quot;  g.\&quot;plannedRSDD\&quot;, g.\&quot;plannedSDD\&quot;, g.\&quot;InnerULDNum\&quot;, g.\&quot;OriginCnyCd\&quot;, &quot;&#xD;&#xA;+&quot;  g.\&quot;DestSortSlic\&quot;, g.\&quot;DestCnyCd\&quot;, &quot;&#xD;&#xA;+&quot;  o.\&quot;OriginSLIC\&quot;, o.\&quot;OriginSortSLIC\&quot;, o.\&quot;OriginCity\&quot;, o.\&quot;OriginState\&quot;, o.\&quot;OriginCountryCC\&quot;, &quot;&#xD;&#xA;+&quot;  o.\&quot;OriginDate\&quot;, o.\&quot;OriginTime\&quot;, o.\&quot;OriginOffset\&quot;, &quot;&#xD;&#xA;+&quot;  o.\&quot;FirstActivity\&quot; AS \&quot;OriginFirstActivity\&quot;, o.\&quot;FirstActivityCode\&quot; AS \&quot;OriginFirstActivityCode\&quot;, &quot;&#xD;&#xA;+&quot;  o.\&quot;FirstScanDate\&quot;, o.\&quot;FirstScanTime\&quot;, &quot;&#xD;&#xA;+&quot;  o.\&quot;PickupDate\&quot;, o.\&quot;PickupTime\&quot;, &quot;&#xD;&#xA;+&quot;  p.\&quot;FirstPhysActivityCode\&quot;, p.\&quot;FirstPhysicalDescription\&quot;, &quot;&#xD;&#xA;+&quot;  p.\&quot;FirstPhysicalDate\&quot;, p.\&quot;FirstPhysicalTime\&quot;, p.\&quot;FirstPhysActGMTOffset\&quot;, &quot;&#xD;&#xA;+&quot;  p.\&quot;ConsigneeSLIC\&quot; AS \&quot;ConsigneeSLIC_P\&quot;, p.\&quot;Service\&quot;, p.\&quot;ServiceGroup\&quot;, p.\&quot;ServiceLevelDescription\&quot;, &quot;&#xD;&#xA;+&quot;  d.\&quot;ActivityCode\&quot; AS \&quot;DeliveryActivityCode\&quot;, d.\&quot;ActivityType\&quot;, d.\&quot;DelActRecordCd\&quot;, d.\&quot;DelOffSet\&quot;, &quot;&#xD;&#xA;+&quot;  d.\&quot;DeliveryAddress1\&quot;, d.\&quot;DeliveryAddress2\&quot;, d.\&quot;DeliveryAddress3\&quot;, &quot;&#xD;&#xA;+&quot;  d.\&quot;DeliveryCity\&quot;, d.\&quot;DeliveryCityFinal\&quot;, d.\&quot;DeliveryCountry\&quot;, d.\&quot;DeliveryCountryCode\&quot;, &quot;&#xD;&#xA;+&quot;  d.\&quot;DeliveryDate\&quot;, d.\&quot;DeliveryPostalCode\&quot;, d.\&quot;DeliverySLIC\&quot;, d.\&quot;DeliveryState\&quot;, d.\&quot;DeliveryStateFinal\&quot;, &quot;&#xD;&#xA;+&quot;  d.\&quot;DeliveryTime\&quot;, d.\&quot;ISODeliveryLocation\&quot;, d.\&quot;ReceivedByClarifiedSign\&quot;, d.\&quot;ResBus\&quot;, &quot;&#xD;&#xA;+&quot;  d.\&quot;TPackage_Shipper\&quot;, d.\&quot;acyGuuid\&quot;, d.\&quot;altTrackNr\&quot;, d.\&quot;billToAccountNumber\&quot;, &quot;&#xD;&#xA;+&quot;  d.\&quot;pkgDelivered\&quot;, d.\&quot;reasonCodeRddVisibility\&quot;, d.\&quot;returnServiceIndictr\&quot;, d.\&quot;rtsInd\&quot;, d.\&quot;shipperAccount\&quot;, &quot;&#xD;&#xA;+&quot;  ps.\&quot;CurrentStatus\&quot;, ps.\&quot;CurrentStatusDescription\&quot;, ps.\&quot;CurrentStatusShortDesc\&quot;, &quot;&#xD;&#xA;+&quot;  ps.\&quot;LatestActLogicFlg\&quot;, ps.\&quot;LatestActivityCity\&quot;, ps.\&quot;LatestActivityCode\&quot;, &quot;&#xD;&#xA;+&quot;  ps.\&quot;LatestActivityCountry\&quot;, ps.\&quot;LatestActivitySLIC\&quot;, ps.\&quot;LatestActivityState\&quot;, &quot;&#xD;&#xA;+&quot;  ps.\&quot;Package_Status_DateTime\&quot;, ps.\&quot;UpdateDate\&quot;, ps.\&quot;UpdateTime\&quot;, ps.\&quot;gmtOffset\&quot; AS \&quot;gmtOffset_PS\&quot;, &quot;&#xD;&#xA;+&quot;  ex.\&quot;Exception_Record_Rank\&quot;, ex.\&quot;LastExceptionDate\&quot;, ex.\&quot;LastExceptionTime\&quot;, &quot;&#xD;&#xA;+&quot;  ex.\&quot;LastExceptionReasonDesc\&quot;, ex.\&quot;LastExceptionReasonCode\&quot;, ex.\&quot;LastExceptionStatusDesc\&quot;, &quot;&#xD;&#xA;+&quot;  ex.\&quot;LastExcReasonCdVIEWABLE\&quot;, ex.\&quot;LastExceptionSLIC\&quot;, ex.\&quot;LastStatusResolCdVIEWABLE\&quot;, &quot;&#xD;&#xA;+&quot;  ex.\&quot;LastResolutionVIEWABLE\&quot;, ex.\&quot;LastExceptionCountry\&quot;, ex.\&quot;LastExceptionCity\&quot;, &quot;&#xD;&#xA;+&quot;  ex.\&quot;LastExceptionState\&quot;, ex.\&quot;LastExceptionStatusCode\&quot;, ex.\&quot;LastExceptionUTCOffSet\&quot; &quot;&#xD;&#xA;+&quot;FROM \&quot;staging\&quot;.\&quot;manifest_base\&quot; m &quot;&#xD;&#xA;+&quot;INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = m.\&quot;PackageID\&quot; &quot;&#xD;&#xA;+&quot;LEFT JOIN \&quot;staging\&quot;.\&quot;general_base\&quot; g ON g.\&quot;PackageID\&quot; = m.\&quot;PackageID\&quot; &quot;&#xD;&#xA;+&quot;LEFT JOIN \&quot;staging\&quot;.\&quot;origin_activity\&quot; o ON o.\&quot;PackageID\&quot; = m.\&quot;PackageID\&quot; &quot;&#xD;&#xA;+&quot;LEFT JOIN \&quot;staging\&quot;.\&quot;physical_activity\&quot; p ON p.\&quot;PackageID\&quot; = m.\&quot;PackageID\&quot; &quot;&#xD;&#xA;+&quot;LEFT JOIN \&quot;staging\&quot;.\&quot;delivery_base\&quot; d ON d.\&quot;PackageID\&quot; = m.\&quot;PackageID\&quot; &quot;&#xD;&#xA;+&quot;LEFT JOIN \&quot;staging\&quot;.\&quot;package_status_base\&quot; ps ON ps.\&quot;PackageId\&quot; = m.\&quot;PackageID\&quot; &quot;&#xD;&#xA;+&quot;LEFT JOIN \&quot;staging\&quot;.\&quot;exception_current_by_package\&quot; ex &quot;&#xD;&#xA;+&quot;  ON ex.\&quot;PackageID\&quot; = m.\&quot;PackageID\&quot; AND ex.\&quot;ClientID\&quot; = m.\&quot;ClientID\&quot;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
