    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO \&quot;control\&quot;.\&quot;silver_starr_watermark\&quot; (\&quot;customer\&quot;, \&quot;client_group\&quot;, \&quot;max_update_time\&quot;, \&quot;updated_at\&quot;) &quot; +&#xD;&#xA;&quot;SELECT '&quot; + context.customer + &quot;', '&quot; + context.client_group + &quot;', &quot; +&#xD;&#xA;&quot;       TO_CHAR(MAX(max_ts) + INTERVAL '1 minute', 'YYYYMMDDHH24MI'), now() &quot; +&#xD;&#xA;&quot;FROM ( &quot; +&#xD;&#xA;&quot;  SELECT MAX(TO_TIMESTAMP(insert_timestamp_cluster_min, 'YYYYMMDDHH24MI')) AS max_ts FROM \&quot;staging\&quot;.\&quot;manifest_base\&quot; m &quot; +&#xD;&#xA;&quot;    INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = m.\&quot;PackageID\&quot; &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT MAX(TO_TIMESTAMP(insert_timestamp_cluster_min, 'YYYYMMDDHH24MI')) FROM \&quot;staging\&quot;.\&quot;general_base\&quot; g &quot; +&#xD;&#xA;&quot;    INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = g.\&quot;PackageID\&quot; &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT MAX(TO_TIMESTAMP(insert_timestamp_cluster_min, 'YYYYMMDDHH24MI')) FROM \&quot;staging\&quot;.\&quot;origin_activity\&quot; o &quot; +&#xD;&#xA;&quot;    INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = o.\&quot;PackageID\&quot; &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT MAX(TO_TIMESTAMP(insert_timestamp_cluster_min, 'YYYYMMDDHH24MI')) FROM \&quot;staging\&quot;.\&quot;physical_activity\&quot; p &quot; +&#xD;&#xA;&quot;    INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = p.\&quot;PackageID\&quot; &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT MAX(TO_TIMESTAMP(insert_timestamp_cluster_min, 'YYYYMMDDHH24MI')) FROM \&quot;staging\&quot;.\&quot;delivery_base\&quot; d &quot; +&#xD;&#xA;&quot;    INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = d.\&quot;PackageID\&quot; &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT MAX(TO_TIMESTAMP(insert_timestamp_cluster_min, 'YYYYMMDDHH24MI')) FROM \&quot;staging\&quot;.\&quot;package_status_base\&quot; ps &quot; +&#xD;&#xA;&quot;    INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = ps.\&quot;PackageId\&quot; &quot; +&#xD;&#xA;&quot;  UNION ALL &quot; +&#xD;&#xA;&quot;  SELECT MAX(updated_at) FROM \&quot;staging\&quot;.\&quot;exception_current_by_package\&quot; e &quot; +&#xD;&#xA;&quot;    INNER JOIN \&quot;staging\&quot;.\&quot;starr_touched_packages\&quot; t ON t.\&quot;PackageID\&quot; = e.\&quot;PackageID\&quot; &quot; +&#xD;&#xA;&quot;) all_max &quot; +&#xD;&#xA;&quot;HAVING MAX(max_ts) IS NOT NULL &quot; +&#xD;&#xA;&quot;ON CONFLICT (\&quot;customer\&quot;, \&quot;client_group\&quot;) DO UPDATE SET &quot; +&#xD;&#xA;&quot;  \&quot;max_update_time\&quot; = EXCLUDED.\&quot;max_update_time\&quot;, &quot; +&#xD;&#xA;&quot;  \&quot;updated_at\&quot; = EXCLUDED.\&quot;updated_at\&quot;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
