    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="SimpleDateFormat doDateFmt = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;);&#xD;&#xA;SimpleDateFormat inTimeFmt = new SimpleDateFormat(&quot;HH.mm.ss&quot;);&#xD;&#xA;SimpleDateFormat outTimeFmt = new SimpleDateFormat(&quot;HHmmss&quot;);&#xD;&#xA;&#xD;&#xA;// DropOff_Date = Date(date#(If(ActivityCode = 'XD', ActivityDate),'MM/DD/YYYY'))&#xD;&#xA;Date dropOffDate = null;&#xD;&#xA;if (&quot;XD&quot;.equals(row3.ActivityCode) &amp;&amp; row3.ActivityDate != null) {&#xD;&#xA;    dropOffDate = doDateFmt.parse(row3.ActivityDate);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// DropOff_Time = Time(Time#(If(ActivityCode = 'XD', ActivityTime), 'hh.mm.ss'), 'hhmmss')&#xD;&#xA;String dropOffTime = null;&#xD;&#xA;if (&quot;XD&quot;.equals(row3.ActivityCode) &amp;&amp; row3.ActivityTime != null) {&#xD;&#xA;    dropOffTime = outTimeFmt.format(inTimeFmt.parse(row3.ActivityTime));&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;output_row.TrackingNumber = row3.TrackingNumber;&#xD;&#xA;output_row.PackageID = row3.PackageID;&#xD;&#xA;output_row.DROPLocalCity = row3.DROPLocalCity;&#xD;&#xA;output_row.DROPZip = row3.DROPZip;&#xD;&#xA;output_row.DropOff_Date = dropOffDate;&#xD;&#xA;output_row.DropOff_Time = dropOffTime;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
