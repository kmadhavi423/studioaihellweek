    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT * EXCEPT(rnk)&#xD;&#xA;FROM (&#xD;&#xA;  SELECT&#xD;&#xA;    commitTime, AccountType, destinationCountryCode, gmtOffset, plannedRSDD, plannedSDD,&#xD;&#xA;    TenantID, TPackage_Shipper, ClientID, TrackingNumber, PackageID, ActivityCode,&#xD;&#xA;    ActivityDate, ActivityTime, committedSDD, committedRSDD, finalMileRDD, shipperAccount,&#xD;&#xA;    billToAccount, ServiceLevelName, ServiceLevelDescription, ServiceGroup, SLIC,&#xD;&#xA;    destinationSlic, Destination_FacilityMnemonic, Destination_FacilityName, ULDNumber,&#xD;&#xA;    ImportTime_ms, insert_timestamp_cluster_min, OriginCnyCd, destinationRDD,&#xD;&#xA;    ROW_NUMBER() OVER (&#xD;&#xA;      PARTITION BY ClientID, PackageID&#xD;&#xA;      ORDER BY&#xD;&#xA;        PARSE_DATETIME('%m/%d/%Y %H:%M:%S',&#xD;&#xA;          CONCAT(CAST(ActivityDate AS STRING), ' ', REPLACE(ActivityTime, '.', ':'))) DESC,&#xD;&#xA;        ImportTime_ms DESC&#xD;&#xA;    ) AS rnk&#xD;&#xA;  FROM `fpgproj-309517.HR.general_base`&#xD;&#xA;  WHERE ClientID &lt;> 4763 AND ClientID &lt;> 5160 AND ActivityCode &lt;> 'PL'&#xD;&#xA;   AND  insert_timestamp_cluster_min > '&quot;+context.general_max_update_time+&quot;'&#xD;&#xA;   AND  TenantID = &quot;+context.tenant_vibe+&quot;&#xD;&#xA;)&#xD;&#xA;WHERE rnk = 1 AND AccountType IS NOT NULL&quot;"/>
