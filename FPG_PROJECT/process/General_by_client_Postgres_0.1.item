    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//input row: input_row.max_update_time  (String, format yyyyMMddHHmm)&#xD;&#xA;SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyyMMddHHmm&quot;);&#xD;&#xA;java.util.Date raw = sdf.parse(input_row.max_update_time);&#xD;&#xA;java.util.Calendar cal = java.util.Calendar.getInstance();&#xD;&#xA;cal.setTime(raw);&#xD;&#xA;cal.add(java.util.Calendar.MINUTE, -120);&#xD;&#xA;context.general_max_update_time = sdf.format(cal.getTime());&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;max_update_time &quot; + context.general_max_update_time);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;&#xD;&#xA;import java.util.Calendar;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1"/>
  </node>
