    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyyMMddHHmm&quot;);&#xD;&#xA;try {&#xD;&#xA;    Date maxTs = sdf.parse(row10.max_insert_ts);   // match your actual link name&#xD;&#xA;    Calendar cal = Calendar.getInstance();&#xD;&#xA;    cal.setTime(maxTs);&#xD;&#xA;    cal.add(Calendar.MINUTE, 1);&#xD;&#xA;    context.general_new_watermark = sdf.format(cal.getTime());&#xD;&#xA;    System.out.println(&quot;New watermark: &quot; + context.general_new_watermark);&#xD;&#xA;} catch (ParseException e) {&#xD;&#xA;    throw new RuntimeException(&quot;Failed to parse max_insert_ts: &quot; + row10.max_insert_ts, e);&#xD;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;&#xD;&#xA;import java.util.Calendar;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_4"/>
