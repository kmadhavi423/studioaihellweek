    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;SimpleDateFormat dateFmt = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;);&#xD;&#xA;SimpleDateFormat inTimeFmt = new SimpleDateFormat(&quot;HH.mm.ss&quot;);&#xD;&#xA;SimpleDateFormat outTimeFmt = new SimpleDateFormat(&quot;HHmmss&quot;);&#xD;&#xA;&#xD;&#xA;// Committime = Time(Time#(commitTime, 'hh.mm.ss'), 'hhmmss')&#xD;&#xA;String committime = (out1.commitTime != null)&#xD;&#xA;    ? outTimeFmt.format(inTimeFmt.parse(out1.commitTime)) : null;&#xD;&#xA;&#xD;&#xA;// RSDDDate = Date(date#(Alt(committedRSDD, plannedRSDD)))  -- uses RAW text, coalesce-style&#xD;&#xA;String rsddRaw = (out1.committedRSDD != null) ? out1.committedRSDD : out1.plannedRSDD;&#xD;&#xA;Date rsddDate = (rsddRaw != null) ? dateFmt.parse(rsddRaw) : null;&#xD;&#xA;&#xD;&#xA;// RDDDate = Date(date#(Alt(finalMileRDD, destinationRDD)))&#xD;&#xA;String rddRaw = (out1.finalMileRDD != null) ? out1.finalMileRDD : out1.destinationRDD;&#xD;&#xA;Date rddDate = (rddRaw != null) ? dateFmt.parse(rddRaw) : null;&#xD;&#xA;&#xD;&#xA;// ConsigneeSLIC = If(Match(ActivityCode, 'OT', 'DS'), SLIC)&#xD;&#xA;String consigneeSlic = (&quot;OT&quot;.equals(out1.ActivityCode) || &quot;DS&quot;.equals(out1.ActivityCode))&#xD;&#xA;    ? out1.SLIC : null;&#xD;&#xA;&#xD;&#xA;// committedSDD / committedRSDD / finalMileRDD / destinationRDD -- self-rename reparse&#xD;&#xA;Date committedSDD = (out1.committedSDD != null) ? dateFmt.parse(out1.committedSDD) : null;&#xD;&#xA;Date committedRSDD = (out1.committedRSDD != null) ? dateFmt.parse(out1.committedRSDD) : null;&#xD;&#xA;Date finalMileRDD = (out1.finalMileRDD != null) ? dateFmt.parse(out1.finalMileRDD) : null;&#xD;&#xA;Date destinationRDD = (out1.destinationRDD != null) ? dateFmt.parse(out1.destinationRDD) : null;&#xD;&#xA;&#xD;&#xA;row4.PackageID = out1.PackageID;&#xD;&#xA;row4.Committime = committime;&#xD;&#xA;row4.RSDDDate = rsddDate;&#xD;&#xA;row4.RDDDate = rddDate;&#xD;&#xA;row4.ConsigneeSLIC = consigneeSlic;&#xD;&#xA;row4.DestCnyCd = out1.destinationCountryCode;&#xD;&#xA;row4.gmtOffset = out1.gmtOffset;&#xD;&#xA;row4.plannedRSDD = out1.plannedRSDD;             // stays TEXT, unparsed -- matches Qlik&#xD;&#xA;row4.plannedSDD = out1.plannedSDD;               // stays TEXT, unparsed -- matches Qlik&#xD;&#xA;row4.TenantID = out1.TenantID;&#xD;&#xA;row4.TPackage_Shipper = out1.TPackage_Shipper;&#xD;&#xA;row4.ClientID = out1.ClientID;&#xD;&#xA;row4.TrackingNumber = out1.TrackingNumber;&#xD;&#xA;row4.committedSDD = committedSDD;&#xD;&#xA;row4.committedRSDD = committedRSDD;&#xD;&#xA;row4.finalMileRDD = finalMileRDD;&#xD;&#xA;row4.destinationRDD = destinationRDD;&#xD;&#xA;row4.shipperAccount = out1.shipperAccount;&#xD;&#xA;row4.billToAccount = out1.billToAccount;&#xD;&#xA;row4.Service = out1.ServiceLevelName;&#xD;&#xA;row4.ServiceLevelDescription = out1.ServiceLevelDescription;&#xD;&#xA;row4.ServiceGroup = out1.ServiceGroup;&#xD;&#xA;row4.SLIC = out1.SLIC;&#xD;&#xA;row4.DestSortSlic = out1.destinationSlic;&#xD;&#xA;row4.InnerULDNum = out1.ULDNumber;&#xD;&#xA;row4.ImportTime_ms = out1.ImportTime_ms;&#xD;&#xA;row4.insert_timestamp_cluster_min = out1.insert_timestamp_cluster_min;&#xD;&#xA;row4.OriginCnyCd = out1.OriginCnyCd;&#xD;&#xA;row4.DropOff_Date = out1.DropOff_Date;&#xD;&#xA;row4.DropOff_Time = out1.DropOff_Time;&#xD;&#xA;row4.DROPLocalCity = out1.DROPLocalCity;&#xD;&#xA;row4.DROPZip = out1.DROPZip;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;&#xD;&#xA;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
