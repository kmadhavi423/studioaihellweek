    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT&#xD;&#xA;  * EXCEPT(rnk)&#xD;&#xA;FROM (&#xD;&#xA;  SELECT&#xD;&#xA;    *,&#xD;&#xA;    ROW_NUMBER() OVER (&#xD;&#xA;      PARTITION BY ClientID, PackageID&#xD;&#xA;      ORDER BY&#xD;&#xA;        PARSE_DATETIME('%m/%d/%Y %H:%M:%S',&#xD;&#xA;          CONCAT(CAST(DelDate AS STRING), ' ', REPLACE(DelDate_Time, '.', ':'))) DESC,&#xD;&#xA;        ImportTime_ms DESC&#xD;&#xA;    ) AS rnk&#xD;&#xA;  FROM `fpgproj-309517.HR.delivery_base`&#xD;&#xA; WHERE   &#xD;&#xA;  (     insert_timestamp_cluster_min > '&quot;+context.delivery_max_update_time+&quot;'&#xD;&#xA;    AND TenantID = &quot;+context.tenant_vibe+&quot;&#xD;&#xA;)&#xD;&#xA;)&#xD;&#xA;WHERE rnk = 1&#xD;&#xA;  AND ClientID &lt;> 4763&#xD;&#xA;  AND ClientID &lt;> 5160&quot;"/>
