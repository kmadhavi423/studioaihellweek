    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Program Files (x86)\Talend-Studio\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="// DeliveryDate = date(date#(DelDate, 'MM/DD/YYYY'))&#xD;&#xA;SimpleDateFormat ddFmt = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;);&#xD;&#xA;Date deliveryDate = null;&#xD;&#xA;if (row3.DelDate != null) {&#xD;&#xA;    try { deliveryDate = ddFmt.parse(row3.DelDate); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad DelDate: &quot; + row3.DelDate, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// DeliveryTime = Time(Time#(DelDate_Time, 'hh.mm.ss'), 'hhmmss')&#xD;&#xA;SimpleDateFormat inTimeFmt = new SimpleDateFormat(&quot;HH.mm.ss&quot;);&#xD;&#xA;SimpleDateFormat outTimeFmt = new SimpleDateFormat(&quot;HHmmss&quot;);&#xD;&#xA;String deliveryTime = null;&#xD;&#xA;if (row3.DelDate_Time != null) {&#xD;&#xA;    try { deliveryTime = outTimeFmt.format(inTimeFmt.parse(row3.DelDate_Time)); }&#xD;&#xA;    catch (ParseException e) { throw new RuntimeException(&quot;Bad DelDate_Time: &quot; + row3.DelDate_Time, e); }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Capitalize(City) — Qlik's Capitalize() title-cases each word&#xD;&#xA;String cityCapitalized = null;&#xD;&#xA;if (row3.City != null) {&#xD;&#xA;    StringBuilder sb = new StringBuilder();&#xD;&#xA;    for (String word : row3.City.toLowerCase().split(&quot; &quot;)) {&#xD;&#xA;        if (word.length() > 0) {&#xD;&#xA;            sb.append(Character.toUpperCase(word.charAt(0))).append(word.substring(1)).append(&quot; &quot;);&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    cityCapitalized = sb.toString().trim();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;row4.PackageID = row3.PackageID;&#xD;&#xA;row4.ActivityCode = row3.ActCode;&#xD;&#xA;row4.ActivityType = row3.ActivityType;&#xD;&#xA;row4.acyGuuid = row3.acyGuuid;&#xD;&#xA;row4.altTrackNr = row3.altTrackNr;&#xD;&#xA;row4.billToAccountNumber = row3.billToAccountNumber;&#xD;&#xA;row4.reasonCodeRddVisibility = row3.reasonCodeRddVisibility;&#xD;&#xA;row4.ClientID = row3.ClientID;&#xD;&#xA;row4.DelTypeID = row3.DelTypeID;&#xD;&#xA;row4.ImportDT = row3.ImportDT;&#xD;&#xA;row4.ImportTime_ms = row3.ImportTime_ms;&#xD;&#xA;row4.ISODeliveryLocation = row3.ISODeliveryLocation;&#xD;&#xA;row4.pkgDelivered = row3.pkgDelivered;&#xD;&#xA;row4.shipperAccount = row3.shipperAccount;&#xD;&#xA;row4.Tenant = row3.Tenant;&#xD;&#xA;row4.TenantID = row3.TenantID;&#xD;&#xA;row4.TPackage_Shipper = row3.TPackage_Shipper;&#xD;&#xA;row4.TrackingNumber = row3.TrackingNumber;&#xD;&#xA;row4.DeliveryAddress1 = row3.Address1;&#xD;&#xA;row4.DeliveryAddress2 = row3.Address2;&#xD;&#xA;row4.DeliveryAddress3 = row3.Address3;&#xD;&#xA;row4.DeliveryCity = cityCapitalized;&#xD;&#xA;row4.DeliveryCityFinal = cityCapitalized;          // duplicate, matches Qlik&#xD;&#xA;row4.DeliveryPostalCode = row3.PC;&#xD;&#xA;row4.DeliverySLIC = row3.SLIC;&#xD;&#xA;row4.DeliveryState = row3.STATE;&#xD;&#xA;row4.DeliveryStateFinal = row3.STATE;              // duplicate, matches Qlik&#xD;&#xA;row4.DelOffSet = row3.gmtOffset;&#xD;&#xA;row4.rtsInd = row3.rtsInd;&#xD;&#xA;row4.ResBus = row3.ResBus;&#xD;&#xA;row4.returnServiceIndictr = row3.returnServiceIndictr;&#xD;&#xA;row4.DelActRecordCd = row3.DelActRecordCd;&#xD;&#xA;row4.DeliveryDate = deliveryDate;&#xD;&#xA;row4.DeliveryTime = deliveryTime;&#xD;&#xA;row4.insert_timestamp_cluster_min = row3.insert_timestamp_cluster_min;&#xD;&#xA;row4.DeliveryCountry = row3.ISO;&#xD;&#xA;row4.DeliveryCountryCode = row3.ISO;               // duplicate, matches Qlik&#xD;&#xA;row4.ReceivedByClarifiedSign = row3.Signature;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.text.SimpleDateFormat;&#xD;&#xA;import java.text.ParseException;&#xD;&#xA;import java.util.Date;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_3">
